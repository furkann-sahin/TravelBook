# Frontend URLs comma-separated (for CORS)
FRONTEND_URLS=http://localhost:8080,http://127.0.0.1:8080

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/travelbook

# JWT secret key
JWT_SECRET=your_jwt_secret_here

# Redis connection URL
# Local development: redis://localhost:6379
# Production (Upstash): rediss://:your_password@your_host.upstash.io:6380
REDIS_URL=redis://localhost:6379

# RabbitMQ connection URL
# Local development: amqp://guest:guest@localhost:5672
# Production (CloudAMQP): amqps://user:password@host.cloudamqp.com/vhost
RABBITMQ_URL=amqp://guest:guest@localhost:5672
